# ==========================================
# NEX FAMILY — VIRTUAL CHILD AI BOT
# Configuration File (.env)
# ==========================================

# 1. Google Gemini API Key (Dapatkan di https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Identitas Keluarga
CHILD_NAME=Cia
FATHER_NAME=Ayah
MOTHER_NAME=Ibu

# 3. Nomor WhatsApp Ayah & Ibu (Format: 628xxxxxxxxxx tanpa tanda +)
# Digunakan untuk mengenali secara akurat apakah pengirim adalah Ayah atau Ibu
FATHER_PHONE=6281234567890
MOTHER_PHONE=6289876543210

# 4. Pengaturan Grup WhatsApp
# Nama grup untuk pencarian otomatis, atau biarkan kosong jika ingin bot aktif di grup tempat Ayah & Ibu berada
TARGET_GROUP_NAME=Keluarga Bahagia
TARGET_GROUP_JID=

# 5. Fitur Pesan Spontan (Autonomous Mode)
# Menentukan apakah anak bisa menyapa duluan sesuai jadwal dan aturan "JANGAN TERLALU AKTIF"
AUTONOMOUS_ENABLED=true
AUTONOMOUS_CHECK_INTERVAL_MINUTES=20
MIN_HOURS_BETWEEN_SPONTANEOUS=3

# 6. Zona Waktu
TIMEZONE=Asia/Jakarta
